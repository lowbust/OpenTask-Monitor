#include <windows.h>
1 RT_MANIFEST "app.manifest"
1 ICON "../assets/opentask.ico"
1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "OpenTask Monitor"
      VALUE "ProductName", "OpenTask Monitor"
      VALUE "FileVersion", "0.3.0"
      VALUE "LegalCopyright", "OpenTask Monitor contributors - MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
